# =============== SYSTEMD SERVICE REGISTRY ===============
# This section documents persistent services for Sparky AI stack.
# Each service is managed by systemd and has a corresponding .service file.

# Embedding microservice (runs E5-Mistral-7B-Instruct on MI100)
SPARKY_EMBED_SERVICE_NAME=sparky-embed-rocm.service

# Preprocessing microservice (runs spaCy + T5 on MI100)
SPARKY_PREPROC_SERVICE_NAME=sparky-preproc-rocm.service

# Weaviate Vector Database (semantic search/memory vector DB)
WEAVIATE_SERVICE_NAME=weaviate.service

# MemOS Memory and Retrieval system service
MEMOS_SERVICE_NAME=memos.service

# Whisper and XTTS Voice AI microservice
SPARKY_VOICE_AI_SERVICE_NAME=sparky-voice-ai.service




# (Add other AI services here as you launch them)
# Example for future LLM service:
# SPARKY_LLM_SERVICE_NAME=sparky-llm.service

# =============== END OF SERVICE REGISTRY ===============

